"""
Practical 8: AI IT Helpdesk Ticket Classifier & Priority Analyzer
NLP (TF-IDF + Logistic Regression) * Explainability * Ethics

How to run:
    python practicals/practical_08_mini_ai/non_ui.py
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from practicals.practical_08_mini_ai.logic import (
    analyze_helpdesk_ticket,
    submit_correction,
    ethics_report,
)


SAMPLES = [
    "My laptop is not connecting to the office Wi-Fi.",
    "The office printer is showing an error and is not printing.",
    "Please install Python and VS Code on my computer.",
    "The production database is down and users cannot access the application.",
    "I forgot my password and cannot log in. Contact: demo.user@college.edu",
]


def main():
    print("=" * 70)
    print("PRACTICAL 8: AI IT HELPDESK ANALYZER")
    print("TF-IDF -> Logistic Regression -> Priority -> Explainability -> Ethics")
    print("=" * 70)

    for i, text in enumerate(SAMPLES, 1):
        print(f"\n--- Case {i} ---")
        print(f"User Input: {text}")
        r = analyze_helpdesk_ticket(text)
        print("AI RESULT")
        print("-" * 34)
        print(f"  Category    : {r['category_label']}")
        print(f"  Priority    : {r['priority']}")
        print(f"  Department  : {r['department']}")
        print(f"  Confidence  : {r['confidence']}%")
        print(f"  Detected    : {', '.join(r['detected_terms'][:5])}")
        print(f"  Explanation : {r['explanation']}")

    print("\n--- Human-in-the-loop correction demo ---")
    fb = submit_correction(
        "The server room printer is not working.",
        predicted_category="Server",
        actual_category="Printer",
    )
    print(fb["message"], f"(feedback_count={fb['feedback_count']})")

    print("\n--- Ethics Report ---")
    for sec in ethics_report()["sections"]:
        print(f"[{sec['title']}]")
        for p in sec["points"]:
            print(f"  * {p}")

    print("\n" + "=" * 70)


if __name__ == "__main__":
    main()
