"""
Practical 9: AI Warehouse Robot Planner
STRIPS + Goal-Stack Planning on a grid.

How to run:
    python practicals/practical_09_planning/non_ui.py
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from practicals.practical_09_planning.logic import plan_warehouse_grid, run_planning_problem


def main():
    print("=" * 70)
    print("PRACTICAL 9: AI WAREHOUSE ROBOT PLANNER")
    print("STRIPS + Goal-Stack * Grid warehouse with user configuration")
    print("=" * 70)

    payload = {
        "rows": 7,
        "cols": 7,
        "robot_start": "(1,1)",
        "package": "(2,5)",
        "delivery": "(6,6)",
        "obstacles": "(2,2), (3,2), (4,2), (4,3)",
        "goal": "deliver_return",
    }
    print("\nUSER INPUT")
    for k, v in payload.items():
        print(f"  {k:16s}: {v}")

    result = plan_warehouse_grid(payload)
    print(f"\nSuccess: {result['success']}  |  Actions: {result['plan_length']}  |  {result['execution_time_ms']} ms")

    print("\nGOAL STACK:", " -> ".join(result.get("goal_stack") or []))
    print("\nPLANNING TRACE")
    for t in result.get("planning_trace") or []:
        print(f"  Step {t['step']}: {t['title']}")
        print(f"           {t['detail']}")

    print("\nGENERATED AI PLAN")
    for i, step in enumerate(result.get("plan") or [], 1):
        print(f"  {i:2d}. {step}")

    print("\nSTATISTICS")
    for k, v in (result.get("statistics") or {}).items():
        print(f"  {k:22s}: {v}")

    print("\n--- Legacy Blocks World (syllabus option) ---")
    bw = run_planning_problem("blocks_world")
    print(f"  Blocks World success={bw['success']} plan_length={bw['plan_length']}")

    print("=" * 70)


if __name__ == "__main__":
    main()
